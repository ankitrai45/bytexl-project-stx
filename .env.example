# Server Port (optional, defaults to 3000)
PORT=3000

# Node Environment ('development' or 'production')
NODE_ENV=production

# PostgreSQL Connection String (Neon or other PostgreSQL provider)
# Format: postgresql://[user]:[password]@[neon_hostname]/[dbname]?sslmode=require
DATABASE_URL=postgresql://neondb_owner:your_password@ep-example-123456.us-east-2.aws.neon.tech/neondb?sslmode=require

# JWT Secret for signing session tokens (use a long, cryptographically random string)
JWT_SECRET=your_strong_random_secret_at_least_32_characters_long
